# ============================================================
# awtrix-flights — configuration
# Copier ce fichier vers .env puis ajuster les valeurs :
#     cp .env.example .env
# ============================================================

# --- Coordonnées de la maison (OBLIGATOIRES) -----------------
# Latitude / longitude en degrés décimaux. Exemple ci-dessous :
# centre de Jargeau (45150). Pour vos coordonnées exactes :
# Google Maps -> clic droit sur votre maison -> "Qu'y a-t-il ici ?"
HOME_LAT=47.8649
HOME_LON=2.1243

# --- Détection ------------------------------------------------
# Rayon de détection autour de la maison, en km (défaut : 5)
RADIUS_KM=5
# Altitude minimale des avions pris en compte, en mètres (défaut : 300)
MIN_ALT_M=300

# --- AWTRIX ---------------------------------------------------
# Hôte(s) de l'écran AWTRIX, séparés par des virgules pour
# synchroniser plusieurs écrans (défaut : 192.168.1.27)
# Exemple 2 écrans : 192.168.1.27,192.168.1.123
AWTRIX_HOST=192.168.1.27
# Port HTTP de l'API AWTRIX (défaut : 80 — port 7001 muet sur
# les firmware 0.98)
AWTRIX_PORT=80

# --- Boucle ---------------------------------------------------
# Période d'interrogation d'OpenSky, en secondes (défaut : 15)
POLL_INTERVAL_SEC=15
# Anti-spam : délai minimal entre 2 affichages du même avion,
# en secondes (défaut : 60)
NOTIFY_COOLDOWN_SEC=60

# --- Affichage personnalisé -----------------------------------
# Gabarit du message. Placeholders : {callsign} {country} {airline}
# {category} {altitude_m} {altitude_ft} {speed_ms} {speed_kmh}
# {distance_km} {track} {direction}
# Défaut : "{callsign} {country} {altitude_m}m {speed_kmh}km/h"
# Exemple avec compagnie + direction :
# MESSAGE_TEMPLATE={callsign} {airline} {direction} {altitude_m}m {speed_kmh}km/h
# MESSAGE_TEMPLATE={callsign} {country} {altitude_m}m {speed_kmh}km/h

# Icône avion orientée selon le cap (true/false, défaut : true)
# ICON_ENABLED=true
# Couleur RGB de l'icône "R,G,B" (défaut : 255,170,0)
# ICON_COLOR=255,170,0
# Orientation de l'ÉCRAN en degrés : rotation du haut de l'écran
# par rapport au nord (0 = haut vers le nord, 90 = haut vers l'est,
# 180 = haut vers le sud, 270 = haut vers l'ouest). Défaut : 0
# AWTRIX_BEARING=0

# Table des compagnies personnalisée (JSON {"AFR": "Air France"})
# AIRLINES_FILE=/data/airlines.json

# --- MQTT (optionnel) -----------------------------------------
# Publication des détections sur un broker MQTT (Mosquitto, EMQX...)
# MQTT_ENABLED=false
# MQTT_HOST=192.168.1.100
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASSWORD=
# Préfixe des topics : <prefix>/detection, <prefix>/status
# MQTT_TOPIC_PREFIX=awtrix-flights

# --- Divers (optionnel) -----------------------------------
# Fuseau horaire des logs (défaut : Europe/Paris)
# TZ=Europe/Paris
