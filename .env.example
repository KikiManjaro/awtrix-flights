# === Coordinates (REQUIRED) ===
HOME_LAT=48.8566
HOME_LON=2.3522

# === Detection ===
RADIUS_KM=5
MIN_ALT_M=300

# === AWTRIX Display ===
AWTRIX_HOST=192.168.1.27
AWTRIX_PORT=80

# === Timing ===
POLL_INTERVAL_SEC=15
NOTIFY_COOLDOWN_SEC=60

# === Display Options ===
MESSAGE_TEMPLATE="{callsign} {country} {altitude_m}m {speed_kmh}km/h"
ICON_ENABLED=false
ICON_COLOR=255,170,0
AWTRIX_BEARING=0
TEXT_CENTER=false

# === MQTT (AWTRIX NG) ===
AWTRIX_MQTT_ENABLED=false
AWTRIX_MQTT_PREFIXES=awtrix1,awtrix2

# === Multi-color text ===
# FIELD_COLORS="callsign=FFAA00,altitude_m=00DFFF,speed_kmh=33FF33"
